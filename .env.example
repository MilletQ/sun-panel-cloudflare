# 通用示例。推荐实际使用 .env.development 和 .env.production 区分开发/生产。
VITE_GLOB_API_URL=/api
VITE_APP_API_BASE_URL=http://127.0.0.1:8787/

# Cloudflare Pages 生产环境请在 Pages 环境变量中设置：
# VITE_GLOB_API_URL=https://你的-worker地址.workers.dev/api

VITE_GLOB_OPEN_LONG_REPLY=false
VITE_GLOB_APP_PWA=false
VITE_APP_VERSION=20260509
